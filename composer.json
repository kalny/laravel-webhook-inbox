{
    "name": "kalny/laravel-webhook-inbox",
    "description": "Webhook processing in a Laravel app",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Kalny\\LaravelWebhookInbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kalny\\LaravelWebhookInbox\\Tests\\": "tests/",
            "Kalny\\LaravelWebhookInbox\\Database\\Factories\\": "database/factories/"
        }
    },
    "authors": [
        {
            "name": "Anton Kalny",
            "email": "kalnyanton@gmail.com"
        }
    ],
    "require-dev": {
        "pestphp/pest": "^5.1",
        "orchestra/testbench": "^11.2",
        "phpstan/phpstan": "^2.2",
        "shipmonk/dead-code-detector": "^1.4",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kalny\\LaravelWebhookInbox\\Providers\\LaravelWebhookInboxServiceProvider"
            ]
        }
    },
    "require": {
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/psr-http-message-bridge": "^8.1",
        "nyholm/psr7": "^1.8",
        "paddlehq/paddle-php-sdk": "^1.17",
        "symfony/http-client": "^8.1"
    }
}
